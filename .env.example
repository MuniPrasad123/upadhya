# Upadhya application
COMPOSE_PROJECT_NAME=upadhya
SPRING_PROFILES_ACTIVE=local
UPADHYA_SERVER_PORT=8091

# PostgreSQL
UPADHYA_POSTGRES_HOST_PORT=55433
UPADHYA_POSTGRES_CONTAINER_PORT=5432
UPADHYA_POSTGRES_DB=upadhya_db
UPADHYA_POSTGRES_SCHEMA=upadhya
UPADHYA_POSTGRES_USER=upadhya_user
UPADHYA_POSTGRES_PASSWORD=change_me_for_local_development

# Qdrant
UPADHYA_QDRANT_HTTP_PORT=6433
UPADHYA_QDRANT_GRPC_PORT=6434

# Textbook storage
UPADHYA_TEXTBOOK_UPLOAD_DIR=./runtime/upadhya/textbooks
UPADHYA_MAX_PDF_SIZE=50MB
UPADHYA_MAX_PDF_SIZE_BYTES=52428800
